{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "outDir": "./js",
    "rootDir": "./_scripts"
  },
  "include": ["_scripts/**/*.ts"],
  "exclude": ["node_modules", "_site", "js"]
}
